// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Profile {
  id        String   @id // Matches auth.users.id
  email     String   @unique
  tdee      Float?
  weight    Float?
  height    Float?
  age       Int?
  gender    String?   // male, female
  activity  String?   // sedentary, light, moderate, active, very_active
  dynamicTDEE Float?
  tdeeSource  String?   // formula, dynamic
  targets     Json?     // Saved macro targets
  
  // Goal Tracking
  goalWeight  Float?
  goalDate    DateTime?
  startWeight Float?
  startDate   DateTime?
  goalType    String?   // lose, gain, maintain
  
  updatedAt DateTime @updatedAt
  
  // Relations
  logs       FoodLog[]
  weightLogs WeightLog[]
  goals      GoalLog[]
}

model GoalLog {
  id          String   @id @default(uuid())
  userId      String
  type        String   // lose, gain, maintain
  startWeight Float
  goalWeight  Float
  targetDate  DateTime
  status      String   // active, completed, abandoned
  createdAt   DateTime @default(now())

  // Relations
  user Profile @relation(fields: [userId], references: [id])
}

model Food {
  id          String   @id @default(uuid())
  name        String
  brand       String?
  calories    Float
  protein     Float
  fat         Float
  carbs       Float
  servingSize   String?
  servingWeight Float?   // Weight in grams
  quantity      Float?   // Base count (e.g. 11)
  unit          String?  // Base unit (e.g. "crackers")
  isPublic    Boolean  @default(false)
  createdById String   // Copied from auth.users.id
  createdAt   DateTime @default(now())
  
  // Relations
  logs        FoodLog[]
  recipeItems RecipeItem[]
  
  @@index([name])
}

model Recipe {
  id          String   @id @default(uuid())
  name        String
  createdById String   // Private: Only owner can see
  description String?
  createdAt   DateTime @default(now())
  
  // Relations
  items       RecipeItem[]
}

model RecipeItem {
  id        String @id @default(uuid())
  recipeId  String
  foodId    String
  quantity  Float  @default(1.0)
  
  recipe    Recipe @relation(fields: [recipeId], references: [id])
  food      Food   @relation(fields: [foodId], references: [id])
}

model FoodLog {
  id        String   @id @default(uuid())
  userId    String
  foodId    String
  date      DateTime @default(now())
  mealType  String   // breakfast, lunch, dinner, snack
  quantity  Float    @default(1.0)
  
  food      Food     @relation(fields: [foodId], references: [id])
  profile   Profile  @relation(fields: [userId], references: [id])
  createdAt DateTime @default(now())
}

model WeightLog {
  id        String   @id @default(uuid())
  userId    String
  weight    Float
  date      DateTime @default(now())
  
  profile   Profile  @relation(fields: [userId], references: [id])
  createdAt DateTime @default(now())
}

model DayNote {
  id        String   @id @default(uuid())
  userId    String
  content   String   @db.Text
  date      String   // Using string YYYY-MM-DD for simpler daily lookups
  createdAt DateTime @default(now())
  
  profile   Profile  @relation(fields: [userId], references: [id])

  @@unique([userId, date])
}
